FROM debian:12-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends openssh-server sudo procps && rm -rf /var/lib/apt/lists/* \
 && useradd -m -s /bin/bash freqtest \
 && echo 'freqtest ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/freqtest && chmod 440 /etc/sudoers.d/freqtest \
 && mkdir -p /run/sshd
COPY qm docker uptime /usr/local/bin/
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/qm /usr/local/bin/docker /usr/local/bin/uptime /usr/local/bin/entrypoint.sh
EXPOSE 22
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
