# freq.toml — PVE FREQ Configuration
# Copy this file to freq.toml and customize for your cluster.
# Generated by freq init

[freq]
version = "1.0.0"
brand = "PVE FREQ"
build = "default"          # personality pack: default (neutral) or personal (bass/dubstep)
ascii = false               # true = ASCII box drawing (PuTTY-safe)
debug = false

[ssh]
service_account = "freq-admin"
connect_timeout = 5
max_parallel = 5
mode = "sudo"               # "root" = SSH as root, "sudo" = SSH as service account + sudo
# legacy_password_file = ""  # uncomment for iDRAC/switch password auth

[pve]
# PVE nodes — add your Proxmox host IPs here
nodes = []
node_names = []

# PVE API token auth (optional — uses REST API instead of SSH for VM ops)
# api_token_id = "freq@pve!dashboard"
# api_token_secret_path = "/etc/freq/credentials/pve-token"
# api_verify_ssl = false

# Per-node storage configuration (uncomment and edit for each node)
# [pve.storage.node1]
# pool = "local-lvm"
# type = "SSD"

[vm.defaults]
cores = 2
ram = 2048
disk = 32
cpu = "x86-64-v2-AES"
machine = "q35"
scsihw = "virtio-scsi-single"
gateway = ""                # REQUIRED — set to your gateway IP
nameserver = "1.1.1.1"

[safety]
protected_vmids = []
protected_ranges = [[900, 999]]
max_failure_percent = 50

[infrastructure]
cluster_name = ""
timezone = "UTC"
# truenas_ip = ""
# pfsense_ip = ""
# opnsense_ip = ""
# synology_ip = ""
# switch_ip = ""
# docker_dev_ip = ""
# docker_config_base = ""
# docker_backup_dir = ""
# snmp_community = "public"

[templates.profiles]
minimal = { cores = 1, ram = 1024, disk = 8 }
standard = { cores = 2, ram = 2048, disk = 32 }
dev = { cores = 4, ram = 4096, disk = 64 }
prod = { cores = 4, ram = 8192, disk = 128 }
docker = { cores = 4, ram = 4096, disk = 64 }

[nic]
bridge = "vmbr0"
mtu = 1500

# NIC profiles — map profile names to VLAN ID lists
# [nic.profiles]
# standard = [100, 200]
# public = [100, 200, 300]
# minimal = [100]

# pfSense integration (uncomment if managing pfSense)
# [pfsense]
# host = ""
# user = "freq-admin"
# config_path = "/cf/conf/config.xml"

# TrueNAS read-only dashboard integration.
# Store the secret by file path or in secure vault host truenas-prod / key api_key.
# [truenas]
# type = "api_key"
# url = "https://192.168.1.20/api/v2.0"
# api_key_file = "/opt/pve-freq/data/secrets/truenas-prod.key"
# api_key_ref = "secrets://truenas-prod"

[services]
dashboard_port = 8888
watchdog_enabled = true
watchdog_port = 9900
agent_port = 9990
# TLS — optional, omit for plaintext HTTP
# tls_cert = "/etc/freq/tls/cert.pem"
# tls_key = "/etc/freq/tls/key.pem"

# Fleet certificate lifecycle.
# Happy path:
#   1. Create a Cloudflare API token with DNS edit access for your zone.
#   2. Put the token in a local 0600 file.
#   3. Run:
#      freq --yes cert bootstrap --base-domain home.example.com --cloudflare-token-file /path/to/cloudflare-token
#   4. Run:
#      freq cert plan
#      freq cert dns-sync --dry-run
#      freq --yes cert dns-sync
#      freq --yes cert issue --deploy
#      freq cert deploy --dry-run
#      freq --yes cert deploy
#      freq cert verify
#
# Bootstrap discovers the Cloudflare zone id, stages only the token path,
# infers Proxmox/TrueNAS/pfSense targets from existing config, and writes
# the managed block. Secrets stay in files, never inline.
# [certificates]
# base_domain = "home.example.com"
# wildcard = true
# issuer = "acme.sh"
# acme_home = "/opt/pve-freq/data/acme"
# acme_auto_install = true
# acme_keylength = "ec-256"
# cert_fullchain_path = "/opt/pve-freq/data/certs/managed/home.example.com/fullchain.cer"
# cert_key_path = "/opt/pve-freq/data/certs/managed/home.example.com/home.example.com.key"
# dns_provider = "cloudflare"
# dns_token_path = "/etc/freq/credentials/cloudflare_dns_token"
# cloudflare_zone_id = "zone-id"
# record_strategy = "public-private-a"  # publishes private IPs in public DNS
#
# [[cert_target]]
# label = "pve-a"
# target_type = "proxmox_ve_node"
# hostname = "pve-a.home.example.com"
# ip = "192.0.2.26"
# port = 8006
# deploy_driver = "proxmox_pvenode"
# cert_source = "wildcard"
# restart_policy = "pveproxy_restart"
# verify_hostname = true
#
# [[cert_target]]
# label = "pfsense"
# target_type = "pfsense"
# hostname = "firewall.home.example.com"
# ip = "192.0.2.1"
# port = 4443
# deploy_driver = "pfsense_config"
# cert_source = "wildcard"
# restart_policy = "webgui_unbound_restart"
# verify_hostname = true
# host_header_check = true
# resolver_private_domain = true

[notifications]
discord_webhook = ""
slack_webhook = ""
# telegram_bot_token = ""
# telegram_chat_id = ""
# smtp_host = ""
# smtp_port = 587
# smtp_user = ""
# smtp_password = ""
# smtp_to = ""
# smtp_tls = true
# ntfy_url = ""
# ntfy_topic = ""
# gotify_url = ""
# gotify_token = ""
# pushover_user = ""
# pushover_token = ""
# webhook_url = ""

# Inline user definitions (optional — replaces users.conf)
# [users.freq-admin]
# role = "admin"
# groups = ""
#
# [users.operator1]
# role = "operator"
# groups = "fleet"

# HTTP monitors — dashboard health checks
# [[monitor]]
# name = "Dashboard"
# url = "http://10.0.0.50:8888/healthz"
# interval = 60
# timeout = 10
# expected_status = 200
