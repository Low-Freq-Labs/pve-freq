{
  "name": "pve-freq-dev-tests",
  "private": true,
  "description": "Development-only browser verification harness for pve-freq. Production remains zero-dependency client-side.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:hermetic": "playwright test --config=playwright.hermetic.config.js",
    "test:e2e:policy": "node --test tests/e2e/support/terminal-global-setup.policy.js",
    "test:e2e:live": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test --config=playwright.live.config.js",
    "test:e2e:live:headed": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test --config=playwright.live.config.js --headed",
    "test:e2e:sandbox": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test --config=playwright.sandbox.config.js",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright install chromium",
    "ui:check": "node tests/support/run_ui_check.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
